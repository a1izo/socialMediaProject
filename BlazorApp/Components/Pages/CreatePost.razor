@page "/posts/new"
@attribute [Authorize]
@inject IPostService PostService
@inject ITagService TagService
@inject NavigationManager NavMgr

<PageTitle>transmit // cybernet</PageTitle>

<div class="container narrow">
    <section class="hud-frame">
        <span class="hud-label">NEW.TRANSMISSION</span>
        <h1 class="display">say something</h1>

        <div class="form">
            <label class="field">
                <span class="field-label">title</span>
                <input class="input input-lg" @bind="title" @bind:event="oninput" maxlength="140" placeholder="a headline worth reading" />
            </label>

            <div class="field">
                <div class="field-label-row">
                    <span class="field-label">body // markdown</span>
                    <div class="segmented segmented-sm">
                        <button type="button" class="@(!preview ? "is-active" : "")" @onclick="() => preview = false">write</button>
                        <button type="button" class="@(preview ? "is-active" : "")" @onclick="() => preview = true">preview</button>
                    </div>
                </div>
                @if (preview)
                {
                    <div class="preview-box"><MarkdownView Text="@body" /></div>
                }
                else
                {
                    <textarea class="input" rows="10" @bind="body" @bind:event="oninput"
                              placeholder="**bold**, *italic*, [links](https://...), - lists, # headings"></textarea>
                }
            </div>

            <label class="field">
                <span class="field-label">tags // comma separated, max 8</span>
                <input class="input" @bind="tagText" @bind:event="oninput" placeholder="art, dither, y2k" list="known-tags" />
                <datalist id="known-tags">
                    @foreach (TagDto tag in knownTags)
                    {
                        <option value="@tag.Name"></option>
                    }
                </datalist>
            </label>
            @if (knownTags.Count > 0)
            {
                <div class="tag-row">
                    @foreach (TagDto tag in knownTags)
                    {
                        <button type="button" class="tag-chip @(Tags.Contains(tag.Name) ? "is-active" : "")" @onclick="() => ToggleTag(tag.Name)">#@tag.Name</button>
                    }
                </div>
            }

            <ErrorBanner Message="@error" />

            <div class="row gap">
                <button class="btn btn-primary btn-lg" type="button" @onclick="CreateAsync" disabled="@(busy || string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))">
                    <Icon Name="send" Size="16" /> transmit
                </button>
                <a class="btn btn-ghost" href="/">cancel</a>
            </div>
        </div>
    </section>
</div>

@code {
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = default!;

    private string title = "";
    private string body = "";
    private string tagText = "";
    private bool preview;
    private bool busy;
    private string? error;
    private List<TagDto> knownTags = new();

    private List<string> Tags => PostDetails.ParseTags(tagText);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            knownTags = await TagService.GetTagsAsync();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private void ToggleTag(string name)
    {
        List<string> tags = Tags;
        if (!tags.Remove(name))
        {
            tags.Add(name);
        }

        tagText = string.Join(", ", tags);
    }

    private async Task CreateAsync()
    {
        busy = true;
        error = null;
        try
        {
            int userId = (await State).User.GetUserId()!.Value;
            PostDto created = await PostService.AddPostAsync(new CreatePostDto
            {
                Title = title,
                Body = body,
                UserId = userId
            });

            foreach (string name in Tags)
            {
                TagDto tag = await TagService.GetOrCreateTagAsync(name);
                await PostService.AddTagAsync(created.Id, tag.Id);
            }

            NavMgr.NavigateTo($"/posts/{created.Id}");
        }
        catch (Exception e)
        {
            error = e.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
