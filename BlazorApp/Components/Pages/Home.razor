@page "/"
@inject IPostService PostService
@inject ITagService TagService
@inject ProfileCardCache Cards
@inject NavigationManager NavMgr

<PageTitle>cybernet</PageTitle>

<div class="timeline">
    <section class="timeline-main">
        <header class="timeline-head feed-head">
            <h1 class="feed-head-title">feed</h1>
            <div class="segmented" role="tablist">
                <button class="@(View != "following" ? "is-active" : "")" type="button" role="tab" @onclick='() => Go(view: "all")'>everyone</button>
                <button class="@(View == "following" ? "is-active" : "")" type="button" role="tab" @onclick='() => Go(view: "following")'>following</button>
            </div>
            <span class="spacer"></span>
            <select class="timeline-sort" value="@(Sort ?? "newest")" @onchange="e => Go(sort: e.Value?.ToString())" aria-label="sort posts">
                <option value="newest">newest</option>
                <option value="oldest">oldest</option>
                <option value="likes">most liked</option>
            </select>
        </header>

        <AuthorizeView>
            <Authorized>
                <QuickComposer OnPosted="OnPostedAsync" />
            </Authorized>
            <NotAuthorized>
                <div class="guest-bar">
                    <span>make a profile that looks like nobody else's.</span>
                    <a class="btn btn-sm btn-primary" href="/register">sign up</a>
                    <a class="btn btn-sm" href="/login">log in</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        @if (activeTag is not null)
        {
            <div class="timeline-filter">
                <span>posts tagged <b>#@activeTag.Name</b></span>
                <a class="btn btn-sm" href="@NavMgr.GetUriWithQueryParameter("tag", (int?)null)">clear</a>
            </div>
        }

        <ErrorBanner Message="@error" />

        @if (loading)
        {
            <Loading />
        }
        else if (needsLogin)
        {
            <div class="timeline-empty">
                <p>log in to see posts from people you follow.</p>
                <a class="btn btn-primary" href="/login">log in</a>
            </div>
        }
        else if (posts.Count == 0)
        {
            <div class="timeline-empty">
                <p>@(View == "following" ? "the people you follow haven't posted yet." : "no posts yet.")</p>
            </div>
        }
        else
        {
            <div class="post-list">
                @foreach (PostDto post in posts)
                {
                    <PostCard @key="post.Id" Post="post" Card="@Cards.Get(post.UserId)" />
                }
            </div>
        }
    </section>

    <RightRail />
</div>

@code {
    [SupplyParameterFromQuery] public int? Tag { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? View { get; set; }

    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = default!;

    private List<PostDto> posts = new();
    private TagDto? activeTag;
    private bool loading = true;
    private bool needsLogin;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        needsLogin = false;
        error = null;
        try
        {
            int? userId = (await State).User.GetUserId();
            if (View == "following" && userId is null)
            {
                needsLogin = true;
                posts = new();
                return;
            }

            activeTag = Tag is null ? null : (await TagService.GetTagsAsync()).FirstOrDefault(t => t.Id == Tag);
            posts = await PostService.GetPostsAsync(new PostQuery
            {
                OrderBy = Sort,
                TagId = Tag,
                FollowedBy = View == "following" ? userId : null
            });
            await Cards.EnsureAsync(posts.Select(p => p.UserId));
        }
        catch (Exception e)
        {
            error = e.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnPostedAsync(PostDto created)
    {
        await LoadAsync();
    }

    private void Go(string? view = null, string? sort = null)
    {
        Dictionary<string, object?> query = new()
        {
            ["view"] = view ?? View,
            ["sort"] = sort ?? Sort,
            ["tag"] = Tag
        };
        NavMgr.NavigateTo(NavMgr.GetUriWithQueryParameters(query));
    }
}
