@page "/"
@inject IPostService PostService
@inject ITagService TagService
@inject ProfileCardCache Cards
@inject NavigationManager NavMgr

<PageTitle>cybernet</PageTitle>

<div class="container feed-layout">
    <AuthorizeView>
        <NotAuthorized>
            <div class="guest-bar">
                <span>you're browsing as a guest.</span>
                <a class="btn btn-sm btn-primary" href="/register">sign up</a>
                <a class="btn btn-sm btn-ghost" href="/login">log in</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <div class="feed-controls">
        <div class="segmented" role="tablist">
            <button class="@(View != "following" ? "is-active" : "")" type="button" @onclick='() => Go(view: "all")'>everyone</button>
            <button class="@(View == "following" ? "is-active" : "")" type="button" @onclick='() => Go(view: "following")'>following</button>
        </div>
        @if (activeTag is not null)
        {
            <a class="tag-chip is-active" href="@NavMgr.GetUriWithQueryParameter("tag", (int?)null)" title="clear the filter">
                #@activeTag.Name <Icon Name="x" Size="12" />
            </a>
        }
        <label class="select-wrap">
            <select value="@(Sort ?? "newest")" @onchange="e => Go(sort: e.Value?.ToString())" aria-label="sort">
                <option value="newest">newest</option>
                <option value="oldest">oldest</option>
                <option value="likes">most liked</option>
            </select>
        </label>
    </div>

    <ErrorBanner Message="@error" />

    @if (loading)
    {
        <Loading />
    }
    else if (needsLogin)
    {
        <div class="empty-state">
            <p>log in to see posts from people you follow.</p>
            <a class="btn btn-primary" href="/login">log in</a>
        </div>
    }
    else if (posts.Count == 0)
    {
        <div class="empty-state">
            <StarGlyph Size="28" />
            <p>@(View == "following" ? "the people you follow haven't posted yet." : "no posts yet.")</p>
            <AuthorizeView>
                <a class="btn btn-primary" href="/post">write the first one</a>
            </AuthorizeView>
        </div>
    }
    else
    {
        <div class="post-list">
            @foreach (PostDto post in posts)
            {
                <PostCard @key="post.Id" Post="post" Card="@Cards.Get(post.UserId)" />
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public int? Tag { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? View { get; set; }

    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = default!;

    private List<PostDto> posts = new();
    private TagDto? activeTag;
    private bool loading = true;
    private bool needsLogin;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        needsLogin = false;
        error = null;
        try
        {
            int? userId = (await State).User.GetUserId();
            if (View == "following" && userId is null)
            {
                needsLogin = true;
                posts = new();
                return;
            }

            activeTag = Tag is null ? null : (await TagService.GetTagsAsync()).FirstOrDefault(t => t.Id == Tag);
            posts = await PostService.GetPostsAsync(new PostQuery
            {
                OrderBy = Sort,
                TagId = Tag,
                FollowedBy = View == "following" ? userId : null
            });
            await Cards.EnsureAsync(posts.Select(p => p.UserId));
        }
        catch (Exception e)
        {
            error = e.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void Go(string? view = null, string? sort = null)
    {
        Dictionary<string, object?> query = new()
        {
            ["view"] = view ?? View,
            ["sort"] = sort ?? Sort,
            ["tag"] = Tag
        };
        NavMgr.NavigateTo(NavMgr.GetUriWithQueryParameters(query));
    }
}
