@page "/settings"
@attribute [Authorize]
@using BlazorApp.Auth
@inject IUserService UserService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavMgr

<PageTitle>settings // cybernet</PageTitle>

<div class="container narrow">
    <section class="hud-frame">
        <h1 class="display">settings</h1>
        <p class="muted">to change how your profile looks, <a href="/u/@userName?edit=true">open the profile editor</a>.</p>

        @if (loading)
        {
            <Loading />
        }
        else
        {
            <form class="form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label class="field">
                    <span class="field-label">user name</span>
                    <input class="input" @bind="userName" maxlength="30" />
                </label>
                <label class="field">
                    <span class="field-label">email</span>
                    <input class="input" type="email" @bind="email" />
                </label>
                <label class="field">
                    <span class="field-label">phone (optional)</span>
                    <input class="input" type="tel" @bind="phone" />
                </label>
                <label class="field">
                    <span class="field-label">new password (leave empty to keep your current one)</span>
                    <input class="input" type="password" @bind="password" autocomplete="new-password" />
                </label>

                <fieldset class="field privacy-options">
                    <legend class="field-label">who can message you</legend>
                    @foreach ((string value, string label, string hint) in PrivacyOptions)
                    {
                        <label class="privacy-option @(messagePrivacy == value ? "is-active" : "")">
                            <input type="radio" name="message-privacy" checked="@(messagePrivacy == value)" @onchange="() => messagePrivacy = value" />
                            <span>
                                <b>@label</b>
                                <span class="muted small">@hint</span>
                            </span>
                        </label>
                    }
                </fieldset>

                <ErrorBanner Message="@error" />
                @if (saved)
                {
                    <p class="success-note"><Icon Name="check" Size="14" /> saved</p>
                }

                <div class="row gap">
                    <button class="btn btn-primary" type="submit">save</button>
                </div>
            </form>

            <div class="danger-zone">
                <span class="hud-label">delete account</span>
                <p class="muted small">this removes your account and your profile for good.</p>
                <ConfirmButton Class="btn btn-danger" Question="really delete your account?" OnConfirm="DeleteAsync">
                    <Icon Name="trash" Size="14" /> delete account
                </ConfirmButton>
            </div>
        }
    </section>
</div>

@code {
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = default!;

    private int userId;
    private string userName = "";
    private string email = "";
    private string phone = "";
    private string password = "";
    private string messagePrivacy = "requests";

    private static readonly (string, string, string)[] PrivacyOptions =
    {
        ("everyone", "everyone", "anyone can start a chat with you"),
        ("requests", "everyone, with requests", "people you don't follow land in your requests first"),
        ("following", "people I follow", "nobody else can message you"),
        ("nobody", "nobody", "no new chats; your existing ones stay")
    };
    private bool loading = true;
    private bool saved;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            userId = (await State).User.GetUserId()!.Value;
            UserDto user = await UserService.GetUserAsync(userId);
            userName = user.UserName;
            email = user.Email;
            phone = user.PhoneNumber ?? "";
            messagePrivacy = user.MessagePrivacy;
        }
        catch (Exception e)
        {
            error = e.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        error = null;
        saved = false;
        try
        {
            await UserService.UpdateUserAsync(userId, new UpdateUserDto
            {
                UserName = userName,
                Email = email,
                PhoneNumber = phone,
                Password = string.IsNullOrWhiteSpace(password) ? null : password,
                MessagePrivacy = messagePrivacy
            });
            UserDto updated = await UserService.GetUserAsync(userId);
            await ((SimpleAuthProvider)AuthProvider).StoreUserAsync(updated);
            password = "";
            saved = true;
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await UserService.DeleteUserAsync(userId);
            await ((SimpleAuthProvider)AuthProvider).Logout();
            NavMgr.NavigateTo("/");
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }
}
