@page "/register"
@using BlazorApp.Auth
@inject IUserService UserService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavMgr

<PageTitle>join // cybernet</PageTitle>

<div class="container narrow auth-page">
    <section class="hud-frame auth-card">
        <span class="hud-label">NEW.NODE // REGISTER</span>
        <h1 class="display">claim your node</h1>
        <p class="muted">pick a name. you'll land straight in your profile editor.</p>

        <form class="form" @onsubmit="RegisterAsync" @onsubmit:preventDefault>
            <label class="field">
                <span class="field-label">user name</span>
                <input class="input" @bind="userName" autocomplete="username" maxlength="30" />
                <span class="field-hint">letters, numbers, _ and - only. this becomes cybernet/u/@(string.IsNullOrWhiteSpace(userName) ? "you" : userName)</span>
            </label>
            <label class="field">
                <span class="field-label">email</span>
                <input class="input" type="email" @bind="email" autocomplete="email" />
            </label>
            <label class="field">
                <span class="field-label">phone // optional</span>
                <input class="input" type="tel" @bind="phone" autocomplete="tel" />
            </label>
            <label class="field">
                <span class="field-label">password</span>
                <input class="input" type="password" @bind="password" autocomplete="new-password" />
            </label>
            <label class="field">
                <span class="field-label">repeat password</span>
                <input class="input" type="password" @bind="repeatPassword" autocomplete="new-password" />
            </label>

            <ErrorBanner Message="@error" />

            <button class="btn btn-primary btn-lg" type="submit" disabled="@busy"><StarGlyph Size="12" /> create account</button>
        </form>
        <p class="muted small">already have one? <a href="/login">log in</a>.</p>
    </section>
</div>

@code {
    private string userName = "";
    private string email = "";
    private string phone = "";
    private string password = "";
    private string repeatPassword = "";
    private bool busy;
    private string? error;

    private async Task RegisterAsync()
    {
        error = null;
        if (!System.Text.RegularExpressions.Regex.IsMatch(userName, "^[A-Za-z0-9_-]{2,30}$"))
        {
            error = "User name must be 2-30 characters: letters, numbers, _ or -.";
            return;
        }

        if (password.Length < 4)
        {
            error = "Password must be at least 4 characters.";
            return;
        }

        if (password != repeatPassword)
        {
            error = "Passwords do not match.";
            return;
        }

        busy = true;
        try
        {
            await UserService.AddUserAsync(new CreateUserDto
            {
                UserName = userName,
                Email = email,
                Password = password,
                PhoneNumber = phone
            });
            await ((SimpleAuthProvider)AuthProvider).LoginAsync(userName, password);
            NavMgr.NavigateTo($"/u/{userName}?edit=true");
        }
        catch (Exception e)
        {
            error = e.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
