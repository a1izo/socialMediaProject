@* Line icons drawn on a 24px grid. Color comes from currentColor. *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@Stroke" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
    @switch (Name)
    {
        case "heart": <path d="M12 20s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.4 4.2 4.2 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z" /> break;
        case "heart-fill": <path d="M12 20s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.4 4.2 4.2 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z" fill="currentColor" /> break;
        case "comment": <path d="M4 5h16v11H9l-5 4V5Z" /> break;
        case "reply": <path d="M10 8 5 12l5 4M5 12h9a5 5 0 0 1 5 5v1" /> break;
        case "edit": <path d="M4 20h4L19 9l-4-4L4 16v4ZM13 7l4 4" /> break;
        case "trash": <path d="M5 7h14M10 7V4h4v3M7 7l1 13h8l1-13" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "minus": <path d="M5 12h14" /> break;
        case "x": <path d="M6 6l12 12M18 6 6 18" /> break;
        case "check": <path d="m5 12 4 4 10-10" /> break;
        case "user": <circle cx="12" cy="8" r="4" /><path d="M4 21c1-4 4-6 8-6s7 2 8 6" /> break;
        case "users": <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.8-3.5 3.3-5 6.5-5s5.7 1.5 6.5 5M15.5 4.6a3.5 3.5 0 0 1 0 6.8M18 15c2 .6 3.2 2.2 3.5 5" /> break;
        case "search": <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /> break;
        case "home": <path d="M4 11 12 4l8 7v9h-5v-6H9v6H4v-9Z" /> break;
        case "logout": <path d="M14 4h6v16h-6M10 8l-4 4 4 4M6 12h10" /> break;
        case "login": <path d="M14 4h6v16h-6M9 8l4 4-4 4M13 12H3" /> break;
        case "gear": <circle cx="12" cy="12" r="3" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" /> break;
        case "sun": <circle cx="12" cy="12" r="4" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /> break;
        case "moon": <path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5Z" /> break;
        case "drag": <path d="M9 5h.01M15 5h.01M9 12h.01M15 12h.01M9 19h.01M15 19h.01" stroke-width="3" /> break;
        case "eye": <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" /><circle cx="12" cy="12" r="3" /> break;
        case "eye-off": <path d="M3 3l18 18M10.6 6c.5-.1.9-.1 1.4-.1 6 0 9.5 6.1 9.5 6.1a17 17 0 0 1-2.6 3.3M6.6 6.6C4 8.4 2.5 12 2.5 12S6 18.5 12 18.5c1.6 0 3-.4 4.2-1" /> break;
        case "link": <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /> break;
        case "globe": <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9S14.5 18.5 12 21c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z" /> break;
        case "music": <path d="M9 18V5l11-2v13" /><circle cx="6.5" cy="18" r="2.5" /><circle cx="17.5" cy="16" r="2.5" /> break;
        case "camera": <path d="M3 7h4l2-3h6l2 3h4v13H3V7Z" /><circle cx="12" cy="13" r="4" /> break;
        case "code": <path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" /> break;
        case "mail": <path d="M3 5h18v14H3V5Zm0 0 9 8 9-8" /> break;
        case "star": <path d="M12 2c.8 6 3.9 9.1 10 10-6.1.9-9.2 4-10 10-.8-6-3.9-9.1-10-10 6.1-.9 9.2-4 10-10Z" /> break;
        case "image": <path d="M3 4h18v16H3V4Z" /><circle cx="8.5" cy="9" r="1.8" /><path d="m3 17 5-5 4 4 3-3 6 6" /> break;
        case "upload": <path d="M12 16V4M7 9l5-5 5 5M4 15v5h16v-5" /> break;
        case "arrow-left": <path d="M19 12H5M11 6l-6 6 6 6" /> break;
        case "arrow-right": <path d="M5 12h14M13 6l6 6-6 6" /> break;
        case "pin": <path d="M9 3h6l-1 6 4 3v2H6v-2l4-3-1-6ZM12 14v7" /> break;
        case "layers": <path d="m12 3 9 5-9 5-9-5 9-5ZM3 13l9 5 9-5" /> break;
        case "palette": <path d="M12 3a9 9 0 1 0 0 18c1.2 0 2-.8 2-1.8 0-1.4-1.3-1.6-1.3-2.9 0-1 .8-1.6 1.8-1.6H17a4 4 0 0 0 4-4C21 6.4 17 3 12 3Z" /><circle cx="7.5" cy="11" r="1" /><circle cx="10" cy="7" r="1" /><circle cx="15" cy="7.5" r="1" /> break;
        case "type": <path d="M4 7V4h16v3M12 4v16M8 20h8" /> break;
        case "grid": <path d="M3 3h8v8H3V3Zm10 0h8v8h-8V3ZM3 13h8v8H3v-8Zm10 0h8v8h-8v-8Z" /> break;
        case "css": <path d="M7 4H5v16h2M17 4h2v16h-2M10 9h4M10 15h4" /> break;
        case "send": <path d="M3 11 21 3l-8 18-2-8-8-2Z" /> break;
        case "shield": <path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6l-8-3Z" /> break;
        case "tag": <path d="M3 3h8l10 10-8 8L3 11V3Z" /><circle cx="7.5" cy="7.5" r="1.5" /> break;
        case "sparkle": <path d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7ZM19 15c.3 2 1 2.7 3 3-2 .3-2.7 1-3 3-.3-2-1-2.7-3-3 2-.3 2.7-1 3-3Z" /> break;
        default: <circle cx="12" cy="12" r="2" /> break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public double Stroke { get; set; } = 1.6;
    [Parameter] public string? Class { get; set; }
}
