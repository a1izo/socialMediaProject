@inject IPostService PostService
@inject ApiConfig Api
@inject NavigationManager NavMgr

@* A post is a small piece of its author's profile: their banner strip on top, their avatar stuck
   onto it, their name in their own display font, and their colors and card style all over.
   Compact mode (inside profile modules) is a plain card, since the profile around it already is the author. *@
<article class="post piece @(Compact ? "post-compact" : "") @ThemedClasses" style="@ThemedStyle">
    @if (IsThemed)
    {
        <FontLinks Urls="@ThemeCss.FontUrls(Card!.Theme.DisplayFont, Card.Theme.BodyFont)" />
    }

    @if (ShowAuthor && !Compact)
    {
        <header class="piece-strip" style="@StripStyle">
            <a class="piece-index" href="/posts/@Post.Id" title="@TimeFormat.Stamp(Post.CreatedDate)">
                no.@Post.Id.ToString("000") · @TimeFormat.Ago(Post.CreatedDate)
            </a>
        </header>
        <div class="piece-author">
            <a class="piece-avatar" href="/u/@Post.AuthorUserName" tabindex="-1" aria-hidden="true">
                <Avatar Url="@Card?.AvatarUrl" Name="@(Card?.DisplayName ?? Post.AuthorUserName)" Shape="@Card?.Theme.AvatarShape" Size="48" />
            </a>
            <UserChip UserName="@Post.AuthorUserName" Card="Card" ShowAvatar="false" />
        </div>
    }
    else
    {
        <div class="piece-meta">
            <a class="piece-index" href="/posts/@Post.Id" title="@TimeFormat.Stamp(Post.CreatedDate)">
                no.@Post.Id.ToString("000") · @TimeFormat.Ago(Post.CreatedDate)
            </a>
        </div>
    }

    <div class="piece-body">
        @if (!string.IsNullOrWhiteSpace(Post.Title))
        {
            <a class="post-title" href="/posts/@Post.Id">@Post.Title</a>
        }

        @if (ShowExcerpt && !string.IsNullOrWhiteSpace(Post.Body))
        {
            <a class="post-text" href="/posts/@Post.Id">@Markdown.ToPlainText(Post.Body, Compact ? 160 : 420)</a>
        }

        @if (Post.Media.Count > 0)
        {
            <MediaGrid Media="Post.Media" />
        }
    </div>

    <footer class="piece-foot">
        <LikeButton Text="true" Liked="@IsLiked" Count="@Post.LikeCount" Busy="@busy" OnToggle="ToggleLikeAsync" />
        <a class="piece-act" href="/posts/@Post.Id#comments">↳ @(Post.CommentCount switch { 0 => "reply", 1 => "1 reply", _ => $"{Post.CommentCount} replies" })</a>
        @foreach (TagDto tag in Post.Tags)
        {
            <a class="piece-tag" href="/?tag=@tag.Id">#@tag.Name</a>
        }
    </footer>
    @if (!string.IsNullOrEmpty(error))
    {
        <ErrorBanner Message="@error" />
    }
</article>

@code {
    [Parameter, EditorRequired] public PostDto Post { get; set; } = default!;
    [Parameter] public ProfileCardDto? Card { get; set; }
    [Parameter] public bool ShowAuthor { get; set; } = true;
    [Parameter] public bool ShowExcerpt { get; set; } = true;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool Themed { get; set; } = true;

    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = default!;

    private int? userId;
    private bool busy;
    private string? error;

    private bool IsThemed => Themed && !Compact && Card is not null;

    private string ThemedClasses => IsThemed
        ? $"post-themed post-style-{CssValues.OneOf(Card!.Theme.CardStyle, "solid", "solid", "glass", "outline", "brutal", "hud", "bare")}"
        : "";

    private string? ThemedStyle => IsThemed
        ? ThemeCss.Variables(Card!.Theme) + ThemeCss.CardBackground(Card.Theme, Api)
        : null;

    // the author's banner, or a strip in their two accent colors when they have none
    private string StripStyle => CssValues.IsUrl(Card?.BannerUrl)
        ? $"background-image:url(\"{Api.Resolve(Card!.BannerUrl)}\");"
        : "";

    private bool IsLiked => userId is not null && Post.LikedByUserIds.Contains(userId.Value);

    protected override async Task OnParametersSetAsync()
    {
        AuthenticationState authenticationState = await State;
        userId = authenticationState.User.GetUserId();
    }

    private async Task ToggleLikeAsync()
    {
        if (userId is null)
        {
            NavMgr.NavigateTo("/login");
            return;
        }

        busy = true;
        error = null;
        try
        {
            if (IsLiked)
            {
                await PostService.UnlikeAsync(Post.Id, userId.Value);
                Post.LikedByUserIds.Remove(userId.Value);
                Post.LikeCount--;
            }
            else
            {
                await PostService.LikeAsync(Post.Id, userId.Value);
                Post.LikedByUserIds.Add(userId.Value);
                Post.LikeCount++;
            }
        }
        catch (Exception e)
        {
            error = e.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
