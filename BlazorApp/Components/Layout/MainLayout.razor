@inherits LayoutComponentBase
@implements IDisposable
@inject ShellThemeService ShellTheme
@inject ActivityService Activity
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavMgr

<div class="shell">
    <div class="shell-grain" aria-hidden="true"></div>
    <div class="shell-scan" aria-hidden="true"></div>

    <header class="topbar">
        <a class="brand" href="/" aria-label="cybernet home"><Wordmark /></a>

        <nav class="topnav" aria-label="main">
            <NavLink class="topnav-link" href="/" Match="NavLinkMatch.All"><Icon Name="home" Size="16" /> feed</NavLink>
            <NavLink class="topnav-link" href="/search"><Icon Name="search" Size="16" /> search</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="topnav-link" href="/post"><Icon Name="plus" Size="16" /> post</NavLink>
                    <NavLink class="topnav-link" href="/messages">
                        <Icon Name="message" Size="16" /> messages
                        <Badge Count="@(Activity.Counts.Messages + Activity.Counts.Requests)" />
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="topbar-right">
            <button class="icon-btn" type="button" @onclick="ShellTheme.ToggleAsync"
                    title="@(ShellTheme.Mode == "void" ? "light mode" : "dark mode")" aria-label="switch between light and dark mode">
                <Icon Name="@(ShellTheme.Mode == "void" ? "sun" : "moon")" />
            </button>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="icon-btn has-badge" href="/notifications" title="notifications" aria-label="notifications">
                        <Icon Name="bell" />
                        <Badge Count="@Activity.Counts.Notifications" />
                    </NavLink>
                    <AuthorizeView Policy="@ClaimsExtensions.ModeratorPolicy" Context="modContext">
                        <span class="mod-badge" title="you're a moderator"><Icon Name="shield" Size="14" /> mod</span>
                    </AuthorizeView>
                    <a class="me-link" href="/u/@context.User.Identity?.Name">
                        <StarGlyph Size="10" />
                        <span>@context.User.Identity?.Name</span>
                    </a>
                    <a class="icon-btn" href="/settings" title="settings" aria-label="settings"><Icon Name="gear" /></a>
                    <button class="icon-btn" type="button" @onclick="LogoutAsync" title="log out" aria-label="log out"><Icon Name="logout" /></button>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-sm btn-ghost" href="/login">log in</a>
                    <a class="btn btn-sm btn-primary" href="/register">sign up</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="page">
        @Body
    </main>

    <nav class="bottombar" aria-label="mobile">
        <NavLink class="bottombar-link" href="/" Match="NavLinkMatch.All"><Icon Name="home" /><span>feed</span></NavLink>
        <NavLink class="bottombar-link" href="/search"><Icon Name="search" /><span>search</span></NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink class="bottombar-link bottombar-main" href="/post"><Icon Name="plus" /><span>post</span></NavLink>
                <NavLink class="bottombar-link has-badge" href="/messages">
                    <Icon Name="message" /><span>messages</span>
                    <Badge Count="@(Activity.Counts.Messages + Activity.Counts.Requests)" />
                </NavLink>
                <NavLink class="bottombar-link" href="@($"/u/{context.User.Identity?.Name}")"><Icon Name="user" /><span>me</span></NavLink>
            </Authorized>
            <NotAuthorized>
                <NavLink class="bottombar-link bottombar-main" href="/register"><Icon Name="sparkle" /><span>sign up</span></NavLink>
                <NavLink class="bottombar-link" href="/login"><Icon Name="login" /><span>log in</span></NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ShellTheme.Changed += OnChanged;
            Activity.Changed += OnChanged;
            AuthProvider.AuthenticationStateChanged += OnAuthChanged;
            await ShellTheme.InitializeAsync();
            await UpdateActivityAsync(AuthProvider.GetAuthenticationStateAsync());
        }
    }

    private void OnChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthChanged(Task<AuthenticationState> state)
    {
        _ = InvokeAsync(() => UpdateActivityAsync(state));
    }

    private async Task UpdateActivityAsync(Task<AuthenticationState> state)
    {
        int? userId = (await state).User.GetUserId();
        if (userId is null)
        {
            Activity.Stop();
        }
        else
        {
            Activity.Start(userId.Value);
        }
    }

    private async Task LogoutAsync()
    {
        await ((SimpleAuthProvider)AuthProvider).Logout();
        NavMgr.NavigateTo("/");
    }

    public void Dispose()
    {
        ShellTheme.Changed -= OnChanged;
        Activity.Changed -= OnChanged;
        AuthProvider.AuthenticationStateChanged -= OnAuthChanged;
    }
}
