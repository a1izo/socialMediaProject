@inherits LayoutComponentBase
@implements IDisposable
@inject ShellThemeService ShellTheme
@inject ActivityService Activity
@inject ProfileCardCache CardCache
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavMgr

<div class="shell">
    <div class="shell-grain" aria-hidden="true"></div>

    <aside class="sidebar" aria-label="main">
        <a class="sidebar-brand" href="/" aria-label="cybernet home">
            <span class="brand-full"><Wordmark /></span>
            <span class="brand-mark"><StarGlyph Size="22" /></span>
        </a>

        <nav class="side-nav">
            <NavLink class="side-link" title="feed" href="/" Match="NavLinkMatch.All"><Icon Name="home" Size="22" /><span>feed</span></NavLink>
            <NavLink class="side-link" title="search" href="/search"><Icon Name="search" Size="22" /><span>search</span></NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="side-link" title="notifications" href="/notifications">
                        <span class="side-icon"><Icon Name="bell" Size="22" /><Badge Count="@Activity.Counts.Notifications" /></span>
                        <span>notifications</span>
                    </NavLink>
                    <NavLink class="side-link" title="messages" href="/messages">
                        <span class="side-icon"><Icon Name="message" Size="22" /><Badge Count="@(Activity.Counts.Messages + Activity.Counts.Requests)" /></span>
                        <span>messages</span>
                    </NavLink>
                    <NavLink class="side-link" title="your profile" href="@($"/u/{context.User.Identity?.Name}")"><Icon Name="user" Size="22" /><span>profile</span></NavLink>
                    <NavLink class="side-link" title="settings" href="/settings"><Icon Name="gear" Size="22" /><span>settings</span></NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <AuthorizeView>
            <Authorized>
                <a class="side-post" href="/post" title="new post" aria-label="new post"><StarGlyph Size="22" /></a>
            </Authorized>
        </AuthorizeView>

        <div class="side-foot">
            <button class="side-link side-theme" type="button" @onclick="ShellTheme.ToggleAsync"
                    aria-label="switch between light and dark mode">
                <Icon Name="@(ShellTheme.Mode == "void" ? "sun" : "moon")" Size="22" />
                <span>@(ShellTheme.Mode == "void" ? "light mode" : "dark mode")</span>
            </button>
            <AuthorizeView>
                <Authorized>
                    <div class="side-account">
                        <a class="side-account-link" href="/u/@context.User.Identity?.Name">
                            <Avatar Url="@me?.AvatarUrl" Name="@(me?.DisplayName ?? context.User.Identity?.Name)" Shape="@me?.Theme.AvatarShape" Size="36" />
                            <span class="side-account-text">
                                <b>@(me?.DisplayName ?? context.User.Identity?.Name)</b>
                                <span>@@@context.User.Identity?.Name
                                    <AuthorizeView Policy="@ClaimsExtensions.ModeratorPolicy" Context="modContext"> · mod</AuthorizeView>
                                </span>
                            </span>
                        </a>
                        <button class="icon-btn" type="button" @onclick="LogoutAsync" title="log out" aria-label="log out"><Icon Name="logout" /></button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="side-auth">
                        <a class="btn btn-primary" href="/register">sign up</a>
                        <a class="btn" href="/login">log in</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </aside>

    <header class="mobile-top">
        <a class="sidebar-brand" href="/" aria-label="cybernet home"><Wordmark /></a>
        <span class="spacer"></span>
        <button class="icon-btn" type="button" @onclick="ShellTheme.ToggleAsync" aria-label="switch between light and dark mode">
            <Icon Name="@(ShellTheme.Mode == "void" ? "sun" : "moon")" />
        </button>
        <AuthorizeView>
            <Authorized>
                <NavLink class="icon-btn has-badge" href="/notifications" aria-label="notifications">
                    <Icon Name="bell" /><Badge Count="@Activity.Counts.Notifications" />
                </NavLink>
                <NavLink class="icon-btn" href="/settings" aria-label="settings"><Icon Name="gear" /></NavLink>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-sm" href="/login">log in</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="page">
        @Body
    </main>

    <nav class="bottombar" aria-label="mobile">
        <NavLink class="bottombar-link" href="/" Match="NavLinkMatch.All"><Icon Name="home" Size="22" /></NavLink>
        <NavLink class="bottombar-link" href="/search"><Icon Name="search" Size="22" /></NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink class="bottombar-link bottombar-main" href="/post" aria-label="new post"><Icon Name="plus" Size="22" /></NavLink>
                <NavLink class="bottombar-link has-badge" href="/messages" aria-label="messages">
                    <Icon Name="message" Size="22" /><Badge Count="@(Activity.Counts.Messages + Activity.Counts.Requests)" />
                </NavLink>
                <NavLink class="bottombar-link" href="@($"/u/{context.User.Identity?.Name}")" aria-label="your profile"><Icon Name="user" Size="22" /></NavLink>
            </Authorized>
            <NotAuthorized>
                <NavLink class="bottombar-join" href="/register">sign up</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private ProfileCardDto? me;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ShellTheme.Changed += OnChanged;
            Activity.Changed += OnChanged;
            AuthProvider.AuthenticationStateChanged += OnAuthChanged;
            await ShellTheme.InitializeAsync();
            await UpdateUserAsync(AuthProvider.GetAuthenticationStateAsync());
        }
    }

    private void OnChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthChanged(Task<AuthenticationState> state)
    {
        _ = InvokeAsync(() => UpdateUserAsync(state));
    }

    private async Task UpdateUserAsync(Task<AuthenticationState> state)
    {
        int? userId = (await state).User.GetUserId();
        if (userId is null)
        {
            Activity.Stop();
            me = null;
        }
        else
        {
            Activity.Start(userId.Value);
            try
            {
                CardCache.Invalidate(userId.Value);
                await CardCache.EnsureAsync(new[] { userId.Value });
                me = CardCache.Get(userId.Value);
            }
            catch (Exception)
            {
                me = null;
            }
        }

        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await ((SimpleAuthProvider)AuthProvider).Logout();
        NavMgr.NavigateTo("/");
    }

    public void Dispose()
    {
        ShellTheme.Changed -= OnChanged;
        Activity.Changed -= OnChanged;
        AuthProvider.AuthenticationStateChanged -= OnAuthChanged;
    }
}
