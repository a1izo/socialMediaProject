@* Ambient four-point stars drifting across the profile. Pure CSS animation; positions are
   generated from the user id so they stay put between renders. *@
<div class="sparkle-layer" aria-hidden="true">
    @foreach (Sparkle sparkle in sparkles)
    {
        <span class="sparkle" style="left:@(sparkle.X)%;top:@(sparkle.Y)%;--s:@(sparkle.Size)px;--d:@(sparkle.Delay)s;--t:@(sparkle.Duration)s">
            <StarGlyph Size="@sparkle.Size" />
        </span>
    }
</div>

@code {
    [Parameter] public int Seed { get; set; }
    [Parameter] public int Density { get; set; } = 2;

    private record Sparkle(int X, int Y, int Size, double Delay, double Duration);

    private List<Sparkle> sparkles = new();
    private string? builtFor;

    protected override void OnParametersSet()
    {
        string key = $"{Seed}|{Density}";
        if (key == builtFor)
        {
            return;
        }

        builtFor = key;
        Random random = new(Seed);
        int count = Math.Clamp(Density, 1, 3) * 10;
        sparkles = Enumerable.Range(0, count)
            .Select(_ => new Sparkle(
                random.Next(0, 100),
                random.Next(0, 100),
                random.Next(6, 20),
                Math.Round(random.NextDouble() * 6, 2),
                Math.Round(3 + random.NextDouble() * 5, 2)))
            .ToList();
    }
}
