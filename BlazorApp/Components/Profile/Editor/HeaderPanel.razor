<section class="ed-section-flat">
    <label class="ed-field">
        <span class="ed-label">display name</span>
        <input class="input input-sm" @bind="Profile.DisplayName" @bind:event="oninput" @bind:after="Changed" maxlength="40" />
    </label>
    <label class="ed-field">
        <span class="ed-label">tagline</span>
        <input class="input input-sm" @bind="Profile.Tagline" @bind:event="oninput" @bind:after="Changed" maxlength="140" />
    </label>

    <ImageField Label="avatar" @bind-Value="Profile.AvatarUrl" @bind-Value:after="Changed" />
    <ChoiceField Label="avatar shape" @bind-Value="Profile.Theme.AvatarShape" @bind-Value:after="Changed"
                 Options='new[] { ("circle", "circle"), ("square", "square"), ("hex", "hex"), ("star", "star") }' />
    <RangeField Label="avatar border" Min="0" Max="10" Unit="px" @bind-Value="Profile.Theme.AvatarBorder" @bind-Value:after="Changed" />

    <ImageField Label="banner" @bind-Value="Profile.BannerUrl" @bind-Value:after="Changed" />
    <RangeField Label="banner height" Min="0" Max="520" Step="10" Unit="px" @bind-Value="Profile.Theme.BannerHeight" @bind-Value:after="Changed" />
    <ChoiceField Label="name alignment" @bind-Value="Profile.Theme.NameAlign" @bind-Value:after="Changed"
                 Options='new[] { ("left", "left"), ("center", "center"), ("right", "right") }' />
</section>

@code {
    [Parameter, EditorRequired] public ProfileDto Profile { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task Changed() => OnChanged.InvokeAsync();
}
