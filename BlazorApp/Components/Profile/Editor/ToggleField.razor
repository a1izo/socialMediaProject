<label class="ed-field ed-toggle">
    <input type="checkbox" checked="@Value" @onchange="e => ValueChanged.InvokeAsync(e.Value is true)" />
    <span class="ed-toggle-track" aria-hidden="true"></span>
    <span class="ed-label">@Label</span>
</label>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
}
