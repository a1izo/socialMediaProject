@page "/u/{UserName}"
@implements IAsyncDisposable
@inject IProfileService ProfileService
@inject IUserService UserService
@inject IMessageService MessageService
@inject ProfileCardCache CardCache
@inject ApiConfig Api
@inject IJSRuntime Js
@inject NavigationManager NavMgr

<PageTitle>@(view?.DisplayName ?? UserName) // cybernet</PageTitle>

@if (loading)
{
    <div class="container"><Loading /></div>
}
else if (view is null)
{
    <div class="container narrow">
        <ErrorBanner Message="@error" />
        <a class="btn" href="/search">find people</a>
    </div>
}
else
{
    if (editing)
    {
        <NavigationLock ConfirmExternalNavigation="@dirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />
        <div class="editor-bar">
            <div class="editor-bar-tabs">
                @foreach ((string key, string label, string icon) in EditorTabs)
                {
                    <button type="button" class="@(panel == key ? "is-active" : "")" @onclick="() => OpenPanel(key)"><Icon Name="@icon" Size="14" /> @label</button>
                }
            </div>
            <span class="spacer"></span>
            @if (dirty)
            {
                <span class="editor-bar-note">unsaved changes</span>
            }
            <button type="button" class="btn btn-sm btn-ghost" @onclick="DiscardAsync">cancel</button>
            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@saving">
                <Icon Name="check" Size="14" /> @(saving ? "saving" : "save")
            </button>
        </div>
    }

    <div class="profile-root cn-themed cn-profile-u@(view.UserId) @ThemeCss.Classes(view.Theme) @(editing ? "is-editing" : "") @(panel is not null && editing ? "has-drawer" : "")"
         style="@ThemeCss.Variables(view.Theme) @ThemeCss.Background(view.Theme, Api)" @ref="root">

        <FontLinks Urls="@ThemeCss.FontUrls(view.Theme)" />
        @if (!plainView && !string.IsNullOrWhiteSpace(view.CustomCss))
        {
            @((MarkupString)$"<style>{ScopedCss}</style>")
        }

        @if (view.Theme.AnimatedBackground != "none")
        {
            <div class="bg-anim bg-@CssValues.OneOf(view.Theme.AnimatedBackground, "none", ThemeCss.AnimatedBackgrounds)" aria-hidden="true"></div>
        }
        <div class="profile-fx" aria-hidden="true"></div>
        @if (view.Theme.Sparkles)
        {
            <SparkleLayer Seed="view.UserId" Density="view.Theme.SparkleDensity" />
        }

        <div class="profile-inner">
            <ErrorBanner Message="@error" />

            <ProfileHeader Profile="view" Editing="editing" OnChanged="MarkDirty" OnOpenHeader="OpenHeaderSettings">
                @if (isOwner)
                {
                    if (!editing)
                    {
                        <button type="button" class="btn btn-primary" @onclick="StartEditing"><Icon Name="palette" Size="14" /> customize</button>
                    }
                }
                else
                {
                    <FollowButton TargetUserId="view.UserId" CurrentUserId="currentUserId" @bind-IsFollowing="isFollowing" @bind-IsFollowing:after="RefreshStatsAsync" />
                    <button type="button" class="btn" @onclick="MessageAsync"><Icon Name="message" Size="14" /> message</button>
                }
                @if (!isOwner && !string.IsNullOrWhiteSpace(view.CustomCss))
                {
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => plainView = !plainView"
                            title="@(plainView ? "show their custom css" : "hide their custom css")">
                        <Icon Name="@(plainView ? "eye" : "eye-off")" Size="14" /> @(plainView ? "their style" : "plain")
                    </button>
                }
            </ProfileHeader>

            <div class="profile-grid">
                @for (int i = 0; i < view.Modules.Count; i++)
                {
                    int index = i;
                    ProfileModuleDto module = view.Modules[i];
                    if (module.IsVisible || editing)
                    {
                        <ModuleFrame @key="module" Profile="view" Module="module" Index="index" Editing="editing"
                                     Selected="@(editing && panel == "module" && selectedIndex == index)"
                                     OnSelect="SelectModule" OnDragStart="i => dragIndex = i" OnDropOn="DropOn"
                                     OnMove="d => Move(index, d)" OnResize="d => Resize(index, d)" OnChanged="MarkDirty" />
                    }
                }
                @if (editing)
                {
                    <button type="button" class="module-add-tile span-12" @onclick='() => OpenPanel("add")'
                            @ondragover:preventDefault="true" @ondrop="DropAtEnd">
                        <Icon Name="plus" Size="20" /> add a module or sticker
                    </button>
                }
                else if (view.Modules.Count(m => m.IsVisible) == 0)
                {
                    <div class="module span-12"><p class="module-empty">nothing here yet.</p></div>
                }
            </div>

            <StickerLayer Stickers="view.Stickers" Editing="editing" SelectedId="@(panel == "sticker" ? selectedStickerId : null)" />
        </div>
    </div>

    if (editing && panel is not null)
    {
        <ProfileEditor Profile="view" Panel="@panel" @bind-StyleSection="styleSection"
                       SelectedModule="SelectedModule" SelectedSticker="SelectedSticker" CurrentUserId="currentUserId"
                       OnChanged="MarkDirty" OnClose="() => panel = null"
                       OnAddModule="AddModule" OnAddSticker="AddSticker"
                       OnDeleteModule="DeleteSelected" OnDuplicateModule="DuplicateSelected"
                       OnDeleteSticker="DeleteSticker" OnDuplicateSticker="DuplicateSticker" OnStickerToFront="StickerToFront" />
    }
}

@code {
    [Parameter] public string UserName { get; set; } = "";
    [SupplyParameterFromQuery(Name = "edit")] public bool? EditOnLoad { get; set; }

    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = default!;

    private static readonly (string, string, string)[] EditorTabs =
    {
        ("looks", "looks", "sparkle"), ("style", "style", "palette"), ("add", "add", "plus"), ("advanced", "advanced", "css")
    };

    // "saved" is what the server has; "view" is what is rendered (a working copy while editing)
    private ProfileDto? saved;
    private ProfileDto? view;
    private bool loading = true;
    private bool editing;
    private bool dirty;
    private bool saving;
    private bool plainView;
    private bool isOwner;
    private bool isFollowing;
    private int? currentUserId;
    private int? selectedIndex;
    private string? selectedStickerId;
    private int? dragIndex;
    private string? panel;
    private string styleSection = "colors";
    private string? error;
    private string? loadedUserName;
    private string? trailState;
    private bool editorScriptOn;
    private ElementReference root;
    private DotNetObjectReference<ProfilePage>? selfReference;

    private ProfileModuleDto? SelectedModule =>
        selectedIndex is not null && view is not null && selectedIndex < view.Modules.Count ? view.Modules[selectedIndex.Value] : null;

    private StickerDto? SelectedSticker => view?.Stickers.FirstOrDefault(s => s.Id == selectedStickerId);

    private string ScopedCss => ProfileCss.Scope(view!.CustomCss, $".cn-profile-u{view.UserId}")
        .Replace("url(\"/uploads/", $"url(\"{Api.BaseUrl}/uploads/");

    protected override async Task OnParametersSetAsync()
    {
        if (loadedUserName == UserName)
        {
            return;
        }

        loadedUserName = UserName;
        loading = true;
        editing = false;
        error = null;
        try
        {
            currentUserId = (await State).User.GetUserId();
            saved = await ProfileService.GetProfileAsync(UserName);
            view = saved;
            isOwner = currentUserId == saved.UserId;
            if (currentUserId is not null && !isOwner)
            {
                List<UserDto> followers = await UserService.GetFollowersAsync(saved.UserId);
                isFollowing = followers.Any(u => u.Id == currentUserId);
            }

            if (isOwner && EditOnLoad == true)
            {
                StartEditing();
            }
        }
        catch (Exception e)
        {
            error = e.Message;
            view = null;
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await SyncTrailAsync();
            await SyncEditorScriptAsync();
        }
        catch (JSDisconnectedException)
        {
            // the circuit is gone
        }
    }

    // the sparkle trail follows the mouse, which needs a few lines of JS
    private async Task SyncTrailAsync()
    {
        string wanted = view is not null && view.Theme.SparkleTrail && !plainView
            ? CssValues.Color(view.Theme.Accent, "#ffffff")
            : "off";
        if (wanted == trailState)
        {
            return;
        }

        trailState = wanted;
        if (wanted == "off") await Js.InvokeVoidAsync("cybernet.trail.disable");
        else await Js.InvokeVoidAsync("cybernet.trail.enable", wanted);
    }

    // dragging stickers and module edges is done in JS, which calls back into the methods below
    private async Task SyncEditorScriptAsync()
    {
        if (editing == editorScriptOn)
        {
            return;
        }

        editorScriptOn = editing;
        if (editing)
        {
            selfReference ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("cybernet.editor.enable", root, selfReference);
        }
        else
        {
            await Js.InvokeVoidAsync("cybernet.editor.disable");
        }
    }

    [JSInvokable]
    public async Task StickerMoved(string id, double x, int y)
    {
        StickerDto? sticker = view?.Stickers.FirstOrDefault(s => s.Id == id);
        if (sticker is null) return;
        sticker.X = Math.Round(Math.Clamp(x, 0, 100), 2);
        sticker.Y = Math.Max(0, y);
        selectedStickerId = id;
        panel = "sticker";
        dirty = true;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task StickerClicked(string id)
    {
        selectedStickerId = id;
        panel = "sticker";
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task ModuleResized(int index, int columns)
    {
        if (view is null || index < 0 || index >= view.Modules.Count) return;
        int[] spans = ProfileModuleTypes.AllowedSpans;
        view.Modules[index].Span = spans.OrderBy(s => Math.Abs(s - columns)).First();
        dirty = true;
        await InvokeAsync(StateHasChanged);
    }

    private void StartEditing()
    {
        view = Clone(saved!);
        editing = true;
        dirty = false;
        panel = "looks";
        selectedIndex = null;
        selectedStickerId = null;
    }

    private void OpenPanel(string name)
    {
        panel = panel == name ? null : name;
    }

    private void OpenHeaderSettings()
    {
        styleSection = "header";
        panel = "style";
    }

    private void SelectModule(int index)
    {
        selectedIndex = index;
        panel = "module";
    }

    private void MarkDirty()
    {
        dirty = true;
    }

    private void AddModule(string type)
    {
        view!.Modules.Add(ModuleCatalog.Create(type));
        selectedIndex = view.Modules.Count - 1;
        panel = "module";
        dirty = true;
    }

    private void AddSticker(StickerDto sticker)
    {
        view!.Stickers.Add(sticker);
        selectedStickerId = sticker.Id;
        panel = "sticker";
        dirty = true;
    }

    private void DeleteSticker()
    {
        view!.Stickers.RemoveAll(s => s.Id == selectedStickerId);
        selectedStickerId = null;
        panel = "add";
        dirty = true;
    }

    private void DuplicateSticker()
    {
        if (SelectedSticker is not StickerDto source) return;
        StickerDto copy = new()
        {
            Kind = source.Kind, Value = source.Value, X = Math.Min(100, source.X + 4), Y = source.Y + 30,
            Size = source.Size, Rotation = source.Rotation, Color = source.Color
        };
        view!.Stickers.Add(copy);
        selectedStickerId = copy.Id;
        dirty = true;
    }

    private void StickerToFront()
    {
        if (SelectedSticker is not StickerDto sticker) return;
        view!.Stickers.Remove(sticker);
        view.Stickers.Add(sticker);
        dirty = true;
    }

    private void DeleteSelected()
    {
        if (SelectedModule is null) return;
        view!.Modules.RemoveAt(selectedIndex!.Value);
        selectedIndex = null;
        panel = "add";
        dirty = true;
    }

    private void DuplicateSelected()
    {
        if (SelectedModule is null) return;
        ProfileModuleDto copy = System.Text.Json.JsonSerializer.Deserialize<ProfileModuleDto>(
            System.Text.Json.JsonSerializer.Serialize(SelectedModule))!;
        view!.Modules.Insert(selectedIndex!.Value + 1, copy);
        selectedIndex++;
        dirty = true;
    }

    private void DropOn(int targetIndex)
    {
        if (dragIndex is null || dragIndex == targetIndex) return;
        MoveTo(dragIndex.Value, targetIndex);
        dragIndex = null;
    }

    private void DropAtEnd()
    {
        if (dragIndex is null) return;
        MoveTo(dragIndex.Value, view!.Modules.Count - 1);
        dragIndex = null;
    }

    private void Move(int index, int direction)
    {
        int target = index + direction;
        if (target < 0 || target >= view!.Modules.Count) return;
        MoveTo(index, target);
    }

    private void MoveTo(int from, int to)
    {
        ProfileModuleDto module = view!.Modules[from];
        view.Modules.RemoveAt(from);
        view.Modules.Insert(to, module);
        if (selectedIndex == from) selectedIndex = to;
        dirty = true;
    }

    private void Resize(int index, int direction)
    {
        ProfileModuleDto module = view!.Modules[index];
        int[] spans = ProfileModuleTypes.AllowedSpans;
        int current = Array.IndexOf(spans, module.Span);
        int next = Math.Clamp((current < 0 ? 2 : current) + direction, 0, spans.Length - 1);
        module.Span = spans[next];
        dirty = true;
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;
        try
        {
            await ProfileService.UpdateProfileAsync(view!.UserId, new UpdateProfileDto
            {
                DisplayName = string.IsNullOrWhiteSpace(view.DisplayName) ? view.UserName : view.DisplayName,
                Tagline = view.Tagline,
                AvatarUrl = view.AvatarUrl,
                BannerUrl = view.BannerUrl,
                Theme = view.Theme,
                CustomCss = view.CustomCss,
                Modules = view.Modules,
                Stickers = view.Stickers
            });
            CardCache.Invalidate(view.UserId);
            saved = await ProfileService.GetProfileAsync(view.UserName);
            view = saved;
            editing = false;
            dirty = false;
            panel = null;
            selectedIndex = null;
            selectedStickerId = null;
        }
        catch (Exception e)
        {
            error = e.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DiscardAsync()
    {
        if (dirty && !await Js.InvokeAsync<bool>("confirm", "throw away your changes?"))
        {
            return;
        }

        view = saved;
        editing = false;
        dirty = false;
        panel = null;
        selectedIndex = null;
        selectedStickerId = null;
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (dirty && !await Js.InvokeAsync<bool>("confirm", "leave without saving?"))
        {
            context.PreventNavigation();
        }
    }

    private async Task MessageAsync()
    {
        if (currentUserId is null)
        {
            NavMgr.NavigateTo("/login");
            return;
        }

        error = null;
        try
        {
            ConversationDto conversation = await MessageService.StartConversationAsync(currentUserId.Value, view!.UserId);
            NavMgr.NavigateTo($"/messages/{conversation.Id}");
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task RefreshStatsAsync()
    {
        try
        {
            CardCache.Invalidate(saved!.UserId);
            saved = await ProfileService.GetProfileAsync(UserName);
            view = saved;
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private static ProfileDto Clone(ProfileDto profile)
    {
        return System.Text.Json.JsonSerializer.Deserialize<ProfileDto>(System.Text.Json.JsonSerializer.Serialize(profile))!;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("cybernet.trail.disable");
            await Js.InvokeVoidAsync("cybernet.editor.disable");
        }
        catch (JSDisconnectedException)
        {
            // the circuit is gone
        }

        selfReference?.Dispose();
    }
}
